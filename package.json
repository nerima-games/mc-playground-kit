{
  "name": "@nerima-games/mc-playground-kit",
  "version": "0.4.0",
  "type": "module",
  "main": "./dist/index.js",
  "description": "Effect-based lifecycle and preview boundaries for the nerima-games Minecraft packages.",
  "homepage": "https://github.com/nerima-games/mc-playground-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-playground-kit.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-playground-kit/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "playground",
    "preview"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.preview.json --pretty false",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.release.json --pretty false",
    "lint": "oxlint --deny-warnings src test apps scripts && ast-grep scan",
    "lint:fix": "oxlint --fix src test apps scripts",
    "preview": "tsx apps/preview-harness/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package:verify": "pnpm build && node scripts/verify-package.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "prepublishOnly": "pnpm verify && pnpm package:verify"
  },
  "dependencies": {
    "@nerima-games/mc-kernel": "0.7.0",
    "@nerima-games/mc-physics": "0.2.2",
    "@nerima-games/mc-save": "0.4.1",
    "@nerima-games/mc-sim": "0.4.2",
    "@nerima-games/mc-worldgen": "0.4.0",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@effect/vitest": "0.30.0",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "knip": "6.33.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
