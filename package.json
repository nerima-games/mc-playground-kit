{
  "name": "@nerima-games/mc-playground-kit",
  "version": "0.1.3",
  "type": "module",
  "description": "Effect-based lifecycle and preview boundaries for the nerima-games Minecraft packages.",
  "homepage": "https://github.com/nerima-games/mc-playground-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-playground-kit.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-playground-kit/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "playground",
    "preview"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.preview.json --pretty false",
    "prebuild": "node scripts/clean-package-dist.mjs",
    "build": "tsc -p tsconfig.package.json --pretty false && esbuild src/index.ts --bundle --format=esm --platform=node --target=node24 --external:effect --sourcemap --outfile=dist/index.js",
    "lint": "oxlint --deny-warnings src test apps scripts",
    "lint:fix": "oxlint --fix src test apps scripts",
    "preview": "tsx apps/preview-harness/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/verify-package.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm test:package"
  },
  "dependencies": {
    "@nerima-games/mc-kernel": "0.4.0",
    "@nerima-games/mc-physics": "0.1.7",
    "@nerima-games/mc-save": "0.2.2",
    "@nerima-games/mc-sim": "0.1.42",
    "@nerima-games/mc-worldgen": "0.1.14",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@effect/vitest": "^0.30.0",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.11"
  }
}
