{
  // The dev preview under apps/preview-harness.
  //
  // A SEPARATE project on purpose. tsconfig.build.json proves that the shipped
  // package has no Node type dependency; it inherits `types: []`, while the
  // shared DOM library is intentional because the package includes its browser
  // lifecycle. Node types are available here for the terminal harness and its
  // CLI-only code. Adding the whole preview to tsconfig.build.json would still
  // couple the published source to this development application.
  //
  // NOTE what this file does NOT do: it does not add @playwright/test or real
  // Port Layers. The screenshot half of docs/testing.md's E2E needs both, plus
  // four real Port Layers that cannot exist until the parents are published.
  // See apps/preview-harness/main.ts.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["apps/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "coverage", "dist"]
}
