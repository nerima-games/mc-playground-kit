{
  "$schema": "https://oxc-project.github.io/oxc/schema/linter.json",
  // oxlint is the ONLY lint/format configuration in this repository.
  // There is deliberately no prettier, no biome and no .editorconfig.
  //
  // The time-source policy is intentionally documented here because oxlint does
  // not enforce every restricted-syntax rule. The checked-in Nix toolchain is
  // the lint authority; rules that are unavailable remain review-enforced.
  //
  // Cross-repository (`@nerima-games/*`) import restrictions are enforced below
  // via `no-restricted-imports`.
  "env": {
    "es2022": true,
    "node": true
  },
  "settings": {
    "typescript": {
      "version": "5.9"
    }
  },
  "plugins": [],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn",
    "style": "warn",
    "restriction": "warn"
  },
  "rules": {
    // TypeScript-specific rules
    // Prefer `type` over `interface` for pure data types (Schema.Struct pattern).
    // The public stage contracts use interfaces because their open shape reads
    // clearly at composition boundaries.
    "@typescript-eslint/consistent-type-definitions": ["warn", "type"],
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "@typescript-eslint/no-floating-promises": "warn",
    "@typescript-eslint/no-misused-new": "warn",
    "@typescript-eslint/no-unnecessary-type-assertion": "warn",
    "@typescript-eslint/no-var-requires": "warn",
    "@typescript-eslint/prefer-enum-initializers": "warn",
    "@typescript-eslint/prefer-for-of": "warn",
    "@typescript-eslint/prefer-literal-enum-member": "warn",

    // Correctness
    "no-array-constructor": "warn",
    "no-empty": "warn",
    "no-eq-null": "warn",
    "no-extra-boolean-cast": "warn",
    "no-fallthrough": "warn",
    "no-irregular-whitespace": "warn",
    "no-self-compare": "warn",
    "no-throw-literal": "warn",
    "no-unreachable": "warn",
    "use-isnan": "warn",
    "valid-typeof": "warn",

    // Suspicious
    "no-console": "warn",
    "no-debugger": "warn",
    "no-empty-function": "warn",
    "no-empty-pattern": "warn",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-redeclare": "warn",
    "no-shadow": "warn",
    "no-unreachable-loop": "warn",
    "no-unused-private-class-members": "warn",

    // Performance
    "no-await-in-loop": "warn",
    "no-loop-func": "warn",
    "no-promise-executor-return": "warn",
    "no-sync": "warn",

    // Style
    //
    // The following 30 pure-formatting ESLint-compat rules were listed here but are NOT
    // implemented by the installed oxlint (1.76.0) — verified empirically: with any one of
    // them present, `oxlint --print-config` (and therefore `pnpm lint`) refuses to parse the
    // config at all ("Rule '<name>' not found in plugin 'eslint'"), so the whole config
    // (including no-restricted-imports below) failed to load. This went unnoticed only because
    // this file used to be named `oxlint.json` (no leading dot), which oxlint never
    // auto-discovers, so none of it — valid or invalid — was ever actually read. Now that the
    // file is `.oxlintrc.json`, these have to be removed rather than merely renamed:
    // array-bracket-spacing, block-spacing, brace-style, camelcase, comma-dangle,
    // comma-spacing, comma-style, computed-property-spacing, eol-last, func-call-spacing,
    // indent, key-spacing, keyword-spacing, linebreak-style, lines-between-class-members,
    // no-mixed-spaces-and-tabs, no-new-object, no-tabs, no-trailing-spaces,
    // no-whitespace-before-property, object-curly-spacing, one-var, operator-linebreak,
    // padded-blocks, quote-props, semi-spacing, space-before-blocks, space-infix-ops,
    // space-unary-ops, spaced-comment. If oxlint reintroduces formatting rules (or this repo
    // adopts a dedicated formatter) these should be reconsidered; see also the
    // `no-restricted-globals`/`no-restricted-syntax` note above for the same class of issue.
    "no-array-method-this-argument": "warn",
    "no-bitwise": "warn",
    // `Context.Tag('...')` (Effect's Tag-class factory, extended by every port in
    // application/*-ports.ts and application/playground.ts) and the `Brand.refined`/
    // `Brand.nominal` constructors this repo declares for its branded primitives
    // (`DurationMillis`, `DeltaTimeSecs`, `MonotonicTimeSecs`) are capitalized functions by convention, not
    // classes — none of them can be called with `new`. Declaring them here is the
    // documented exception the rule's own message points to, not a suppression.
    "new-cap": ["warn", { "capIsNewExceptions": ["Tag", "DurationMillis", "DeltaTimeSecs", "MonotonicTimeSecs"] }],
    // `T`, `K`, `E`, `R` etc. are TypeScript's own convention for generic type
    // parameters (Effect's own `Effect<A, E, R>` uses exactly this pattern) and are
    // not runtime identifiers a reader has to keep track of across a function body;
    // `checkGeneric: false` scopes the length floor to actual bindings instead.
    "id-length": ["warn", { "checkGeneric": false }],
    // `_tag` is Effect's own discriminant field name on every tagged union it
    // produces (`Option`, `Either`, every `Data.TaggedError`) — not a naming choice
    // this repository made and not something a test asserting on `.option(x)._tag`
    // could rename.
    "no-underscore-dangle": ["warn", { "allow": ["_tag"] }],

    // Restriction
    "default-case": "warn",
    "default-case-last": "warn",
    "no-empty-character-class": "warn",
    // Declared for intent; this rule is currently review-enforced because the
    // available oxlint release does not implement it.
    "no-restricted-globals": ["warn", "name", "open", "close", "event"],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "effect",
            "message": "Please use named imports from 'effect' package",
            "importNames": ["default"]
          }
        ],
        "patterns": [
          {
            "group": [
              "@nerima-games/**",
              "!@nerima-games/mc-kernel",
              "!@nerima-games/mc-kernel/**",
              "!@nerima-games/mc-worldgen",
              "!@nerima-games/mc-worldgen/**",
              "!@nerima-games/mc-sim",
              "!@nerima-games/mc-sim/**",
              "!@nerima-games/mc-render",
              "!@nerima-games/mc-render/**",
              "!@nerima-games/mc-physics",
              "!@nerima-games/mc-physics/**",
              "!@nerima-games/mc-save",
              "!@nerima-games/mc-save/**"
            ],
            "message": "mc-playground-kit is Tier2 (DEPENDENCY_POLICY.md §1); only the listed packages may be imported."
          }
        ]
      }
    ],
    "prefer-template": "warn",

    // Disabled rules (conflict with project style)
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-non-null-assertion": "off",
    "no-case-declarations": "off",
    "no-constant-condition": "off",
    "no-param-reassign": "off",
    "no-plusplus": "off"
  },
  // Org policy (2026-08-08): src/ stays fully strict — every warning above gets a real
  // fix, never a disable comment. test/**, scripts/** and apps/** (preview/dev tooling)
  // relax the style rules that fire on patterns those directories use by design: test
  // assertions compare against literal expected values (no-magic-numbers), fixtures and
  // scripts favor short loop/index identifiers (id-length), scripts print to stdout
  // (no-console), and none of this is src/'s domain logic.
  "overrides": [
    {
      "files": ["test/**", "apps/**", "scripts/**"],
      "rules": {
        "no-magic-numbers": "off",
        "id-length": "off",
        "no-ternary": "off",
        "no-nested-ternary": "off",
        "sort-keys": "off",
        "sort-imports": "off",
        "capitalized-comments": "off",
        "no-undefined": "off",
        "func-names": "off",
        "max-statements": "off",
        "prefer-destructuring": "off",
        "no-continue": "off",
        "max-params": "off",
        "new-cap": "off",
        "no-use-before-define": "off",
        "complexity": "off",
        "no-void": "off",
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules/**", "coverage/**", "dist/**", ".git/**", "*.config.ts", "docs/**"]
}
